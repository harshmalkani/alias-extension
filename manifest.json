{
  "manifest_version": 3,
  "name": "Alias — URL Shortener",
  "short_name": "Alias",
  "version": "1.0.0",
  "description": "Shorten any URL instantly with alias.live. Right-click any link or page, or open the popup.",

  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "notifications",
    "offscreen"
  ],

  "host_permissions": [
    "https://alias.live/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Alias URL Shortener",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
